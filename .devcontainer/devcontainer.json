{
    "name": "Auto E2E Test Tool",
    "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",
    // 便利な拡張機能（Features）でPoetryを追加、Node.jsの実行環境も追加
    "features": {
        "ghcr.io/devcontainers-extra/features/poetry:2": {},
        "ghcr.io/devcontainers/features/node:1": {}
    },
    // VS Code内の設定（Pythonのパスなど）
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.terminal.activateEnvInSelectedTerminal": true
            }
        }
    },
    // コンテナ作成後にライブラリを自動インストール
    // プロジェクト内に .venv を作る設定を挟むのがコツです
    "postCreateCommand": "poetry config virtualenvs.in-project true && poetry install",
    // マウントさせる場合、以下に記載
    // "mounts": [
    //     "source=path/to/source,target=path/to/target,type=bind"
    // ]
}